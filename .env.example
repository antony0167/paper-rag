# Which LLM writes the answers (and generates/judges the test set).
#   ollama | openai | anthropic | openai_compatible
LLM_PROVIDER=ollama
# LLM_MODEL=qwen2.5:7b
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_BASE_URL=http://localhost:11434/v1
# JUDGE_MODEL=            # defaults to LLM_MODEL; a stronger judge is better if you have one

# RAG_EMBED_MODEL=BAAI/bge-small-en-v1.5
# RAG_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
